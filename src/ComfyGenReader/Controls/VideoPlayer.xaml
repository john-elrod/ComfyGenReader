<UserControl x:Class="ComfyGenReader.Controls.VideoPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">
    <!-- Two parts declared together for names and handlers. The constructor makes View this control's
         content (the video surface) and leaves ControlsBar for the host to place below it. -->
    <Grid x:Name="Parts">
        <vlc:VideoView x:Name="View">
            <!-- VideoView's native HWND swallows WPF drag events; this near-transparent overlay receives them. -->
            <Grid x:Name="DropOverlay" x:FieldModifier="public" Background="#01000000" AllowDrop="True"
                  MouseLeftButtonUp="Surface_MouseLeftButtonUp">
                <TextBlock x:Name="PreparingText" Text="Preparing video player…" Visibility="Collapsed"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </vlc:VideoView>

        <DockPanel x:Name="ControlsBar" x:FieldModifier="public" Margin="0,6,0,0">
            <Button x:Name="PlayPauseButton" DockPanel.Dock="Left" MinWidth="80" Padding="10,2"
                    Content="▶ Play" Click="PlayPause_Click" />
            <Button x:Name="StopButton" DockPanel.Dock="Left" Margin="6,0,0,0" Padding="10,2"
                    Content="⏹ Stop" Click="Stop_Click" />
            <Button x:Name="MuteButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2"
                    Content="🔇" ToolTip="Unmute" Click="Mute_Click" />
            <TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center"
                       FontFamily="Consolas" Text="00:00 / 00:00" />
            <!-- Zero-size in layout; positioned above the seek bar. The last child (SeekBar) fills. -->
            <Popup x:Name="ScrubPopup" Placement="Top" IsHitTestVisible="False">
                <Border BorderThickness="1" Background="Black"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                    <Image x:Name="ScrubImage" Width="160" Stretch="Uniform" />
                </Border>
            </Popup>
            <Slider x:Name="SeekBar" Margin="6,0,0,0" Minimum="0" Maximum="1" VerticalAlignment="Center"
                    IsMoveToPointEnabled="True" SmallChange="0.01" LargeChange="0.1"
                    ValueChanged="SeekBar_ValueChanged"
                    Thumb.DragStarted="SeekBar_DragStarted" Thumb.DragCompleted="SeekBar_DragCompleted"
                    MouseMove="SeekBar_MouseMove" MouseLeave="SeekBar_MouseLeave" />
        </DockPanel>
    </Grid>
</UserControl>
