<Window x:Class="ComfyGenReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ComfyGenReader.Controls"
        Title="ComfyGenReader"
        Width="1200" Height="800" MinWidth="400" MinHeight="400"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top frame: path box, Browse, GO, recent files -->
        <Grid Grid.Row="0" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PathBox" Grid.Column="0" VerticalContentAlignment="Center"
                     Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="PathBox_KeyDown" />
            <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,2" Content="Browse…" Click="Browse_Click" />
            <Button Grid.Column="2" Margin="6,0,0,0" Padding="10,2" Content="GO" Click="Go_Click" />
            <ToggleButton x:Name="DarkModeToggle" Grid.Column="3" Margin="6,0,0,0" Padding="10,2" Content="Dark mode"
                          ToolTip="Switch between the dark and light theme" />

            <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0">
                <ComboBox x:Name="RecentCombo" IsEditable="False"
                          ItemsSource="{Binding Recent}"
                          SelectionChanged="RecentCombo_SelectionChanged" />
                <TextBlock Text="Recent files" IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=RecentCombo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Left frame: preview (image or video), video controls, navigation -->
            <Grid Grid.Column="0" Margin="6,0,3,6" AllowDrop="True" Background="Transparent"
                  DragOver="Preview_DragOver" Drop="Preview_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="PreviewHost" Grid.Row="0">
                    <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="Both" />
                    <controls:VideoPlayer x:Name="Player" Visibility="Collapsed" Failed="Player_Failed" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentFile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Drag a file here" FontSize="16" Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="VideoControlsHost" Grid.Row="1" Visibility="Collapsed" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button Content="◀ Previous" Padding="10,2" IsEnabled="{Binding CanGoPrevious}"
                            Click="Previous_Click" />
                    <Button Content="Next ▶" Padding="10,2" Margin="6,0,0,0" IsEnabled="{Binding CanGoNext}"
                            Click="Next_Click" />
                </StackPanel>
            </Grid>

            <!-- Right frame: highlights, raw metadata, export -->
            <Grid Grid.Column="1" Margin="3,0,6,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Highlights">
                    <StackPanel Margin="4">
                        <TextBlock Text="Seed" />
                        <TextBox IsReadOnly="True" Margin="0,2,0,6"
                                 Text="{Binding SeedText, Mode=OneWay}" />
                        <TextBlock Text="Prompt" />
                        <TextBox IsReadOnly="True" Margin="0,2,0,0"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Visible" MinLines="5" MaxLines="5"
                                 Text="{Binding PromptText, Mode=OneWay}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Raw" Margin="0,6,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <ToggleButton x:Name="WrapToggle" Padding="6,0" Content="Wrap" ToolTip="Word wrap" IsChecked="True" />
                            <ToggleButton Margin="4,0,0,0" Padding="6,0" Content="Raw"
                                          ToolTip="Show the metadata exactly as stored in the file (off: formatted, line breaks fixed)"
                                          IsChecked="{Binding ShowUnmodified}" />
                        </StackPanel>

                        <!-- Find bar (Ctrl+F), case-insensitive. Right-docked children sit right to left. -->
                        <DockPanel x:Name="FindBar" Grid.Row="1" Margin="0,0,0,4" Visibility="Collapsed">
                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0" Content="✕"
                                    ToolTip="Close (Esc)" Click="FindClose_Click" />
                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0" Content="▼"
                                    ToolTip="Next (Enter, F3)" Click="FindNext_Click" />
                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0" Content="▲"
                                    ToolTip="Previous (Shift+Enter, Shift+F3)" Click="FindPrevious_Click" />
                            <TextBlock x:Name="FindStatus" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FindBox" VerticalContentAlignment="Center"
                                     TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown" />
                        </DockPanel>

                        <!-- Search matches are painted behind the text: RawBox is transparent over the highlighter.
                             RawBox has no local Style (it would replace the theme's), so WrapToggle sets TextWrapping in code. -->
                        <Border Grid.Row="2" Background="{DynamicResource TextControlBackground}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <controls:MatchHighlighter x:Name="Highlighter" IsHitTestVisible="False"
                                                       MatchBrush="{DynamicResource FindMatchBrush}"
                                                       CurrentBrush="{DynamicResource FindCurrentMatchBrush}" />
                        </Border>
                        <TextBox x:Name="RawBox" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" Background="Transparent"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding RawText, Mode=OneWay}" TextChanged="RawBox_TextChanged">
                            <!-- The theme repaints a TextBox's background on hover and focus, which would cover the highlighter. -->
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </GroupBox>

                <Button Grid.Row="2" Content="Export" HorizontalAlignment="Right" Margin="0,6,0,0" Padding="10,2"
                        IsEnabled="{Binding CanExport}" Click="Export_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
