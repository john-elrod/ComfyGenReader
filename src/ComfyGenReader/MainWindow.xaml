<Window x:Class="ComfyGenReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ComfyGenReader.Controls"
        Title="ComfyGenReader"
        Width="1200" Height="800" MinWidth="400" MinHeight="400"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top frame: path box, Browse, GO, recent files -->
        <Grid Grid.Row="0" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PathBox" Grid.Column="0" VerticalContentAlignment="Center"
                     Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="PathBox_KeyDown" />
            <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,2" Content="Browse…" Click="Browse_Click" />
            <Button Grid.Column="2" Margin="6,0,0,0" Padding="10,2" Content="GO" Click="Go_Click" />
            <ToggleButton x:Name="DarkModeToggle" Grid.Column="3" Margin="6,0,0,0" Padding="10,2" Content="Dark mode"
                          ToolTip="Switch between the dark and light theme" />

            <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0">
                <ComboBox x:Name="RecentCombo" IsEditable="False"
                          ItemsSource="{Binding Recent}"
                          SelectionChanged="RecentCombo_SelectionChanged" />
                <TextBlock Text="Recent files" IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=RecentCombo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- Left frame: preview (image or video), video controls, navigation -->
            <Grid Grid.Column="0" Margin="6,0,3,6" AllowDrop="True" Background="Transparent"
                  DragOver="Preview_DragOver" Drop="Preview_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="PreviewHost" Grid.Row="0">
                    <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="Both" />
                    <controls:VideoPlayer x:Name="Player" Visibility="Collapsed" Failed="Player_Failed" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentFile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Drag a file here" FontSize="16" Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="VideoControlsHost" Grid.Row="1" Visibility="Collapsed" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button Content="◀ Previous" Padding="10,2" IsEnabled="{Binding CanGoPrevious}"
                            Click="Previous_Click" />
                    <Button Content="Next ▶" Padding="10,2" Margin="6,0,0,0" IsEnabled="{Binding CanGoNext}"
                            Click="Next_Click" />
                </StackPanel>
            </Grid>

            <!-- Middle column (seed, raw metadata, export) and right column (prompt) share this grid, 2*:4*, so the page is 3:2:4.
                 They sit in one grid because the scroll bar styles below serve both. -->
            <Grid Grid.Column="1" Margin="3,0,6,6">
                <!-- Fluent shows only a thin thumb until the pointer is over the bar, so Prompt and Raw (the only boxes here
                     with scroll bars on) get the expanded look all the time: track, arrows and a wider thumb.
                     Same 12px footprint as Fluent's, so the text layout does not change. -->
                <Grid.Resources>
                    <Style x:Key="ScrollBarArrowStyle" TargetType="RepeatButton">
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Foreground" Value="{DynamicResource ScrollBarButtonArrowForeground}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Width="12" Height="12" Background="Transparent">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8"
                                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="ScrollBarPageStyle" TargetType="RepeatButton">
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{DynamicResource ScrollBarThumbFill}" CornerRadius="4" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ScrollBar">
                        <!-- Cursor is inherited, so without this the bars show the TextBox's I-beam. -->
                        <Setter Property="Cursor" Value="Arrow" />
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="12" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Border Background="{DynamicResource ScrollBarTrackFillPointerOver}" CornerRadius="6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <RepeatButton Grid.Row="0" Style="{StaticResource ScrollBarArrowStyle}"
                                                                  Command="ScrollBar.LineUpCommand" Content="&#xEDDB;" />
                                                    <Track x:Name="PART_Track" Grid.Row="1" Width="8" IsDirectionReversed="True">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Style="{StaticResource ScrollBarPageStyle}" Command="ScrollBar.PageUpCommand" />
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Style="{StaticResource ScrollBarPageStyle}" Command="ScrollBar.PageDownCommand" />
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                    <RepeatButton Grid.Row="2" Style="{StaticResource ScrollBarArrowStyle}"
                                                                  Command="ScrollBar.LineDownCommand" Content="&#xEDDC;" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="12" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Border Background="{DynamicResource ScrollBarTrackFillPointerOver}" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <RepeatButton Grid.Column="0" Style="{StaticResource ScrollBarArrowStyle}"
                                                                  Command="ScrollBar.LineLeftCommand" Content="&#xEDD9;" />
                                                    <Track x:Name="PART_Track" Grid.Column="1" Height="8">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Style="{StaticResource ScrollBarPageStyle}" Command="ScrollBar.PageLeftCommand" />
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Style="{StaticResource ScrollBarPageStyle}" Command="ScrollBar.PageRightCommand" />
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                    <RepeatButton Grid.Column="2" Style="{StaticResource ScrollBarArrowStyle}"
                                                                  Command="ScrollBar.LineRightCommand" Content="&#xEDDA;" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Grid.Column="0" Header="Seed" Margin="0,0,3,0">
                    <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="True" Margin="4"
                             Text="{Binding SeedText, Mode=OneWay}" />
                </GroupBox>

                <GroupBox Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Header="Prompt" Margin="3,0,0,0">
                    <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="True" Margin="4"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Visible"
                             Text="{Binding PromptText, Mode=OneWay}" />
                </GroupBox>

                <GroupBox Grid.Row="1" Grid.Column="0" Header="Raw" Margin="0,6,3,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <ToggleButton x:Name="WrapToggle" Padding="6,0" Content="Wrap" ToolTip="Word wrap" IsChecked="True" />
                            <ToggleButton Margin="4,0,0,0" Padding="6,0" Content="Raw"
                                          ToolTip="Show the metadata exactly as stored in the file (off: formatted, line breaks fixed)"
                                          IsChecked="{Binding ShowUnmodified}" />
                        </StackPanel>

                        <!-- Find bar (Ctrl+F), case-insensitive. Right-docked children sit right to left. -->
                        <DockPanel x:Name="FindBar" Grid.Row="1" Margin="0,0,0,4" Visibility="Collapsed">
                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0" Content="✕"
                                    ToolTip="Close (Esc)" Click="FindClose_Click" />
                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0" Content="▼"
                                    ToolTip="Next (Enter, F3)" Click="FindNext_Click" />
                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,0" Content="▲"
                                    ToolTip="Previous (Shift+Enter, Shift+F3)" Click="FindPrevious_Click" />
                            <TextBlock x:Name="FindStatus" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="FindBox" VerticalContentAlignment="Center"
                                     TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown" />
                        </DockPanel>

                        <!-- Search matches are painted behind the text: RawBox is transparent over the highlighter.
                             RawBox has no local Style (it would replace the theme's), so WrapToggle sets TextWrapping in code. -->
                        <Border Grid.Row="2" Background="{DynamicResource TextControlBackground}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <controls:MatchHighlighter x:Name="Highlighter" IsHitTestVisible="False"
                                                       MatchBrush="{DynamicResource FindMatchBrush}"
                                                       CurrentBrush="{DynamicResource FindCurrentMatchBrush}" />
                        </Border>
                        <TextBox x:Name="RawBox" Grid.Row="2" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 FontFamily="Consolas" Background="Transparent"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding RawText, Mode=OneWay}" TextChanged="RawBox_TextChanged">
                            <!-- The theme repaints a TextBox's background on hover and focus, which would cover the highlighter. -->
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </GroupBox>

                <Button Grid.Row="2" Grid.Column="0" Content="Export" HorizontalAlignment="Right" Margin="0,6,3,0" Padding="10,2"
                        IsEnabled="{Binding CanExport}" Click="Export_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
